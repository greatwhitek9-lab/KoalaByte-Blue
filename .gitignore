# KoalaByte Blue generated files
/build/
/dist/
/artifacts/

# Runtime logs and generated status reports
/logs/**/*.json
/logs/**/*.jsonl
/logs/**/*.log
/logs/**/*.txt
/logs/**/*.lock
/logs/**/*.env
/logs/**/*.sock
/logs/**/*.pid
/logs/nrf_connect_sdk_env.sh
/logs/nrf_connect_sdk_status.json

# Locally generated release bundles
/releases/koalabyte-blue-current/
/releases/**/*.zip
/releases/**/*.tar.gz

# Local configuration and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Python / virtual environments / coverage
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
pi-companion/.venv/
.venv/

# PlatformIO / embedded build artifacts
**/.pio/
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch/
*.elf
*.map

# ESP32 DualEye generated sources and build-only vendored dependencies.
# These are recreated by the firmware build scripts and are intentionally
# removed by scripts/cleanup_firmware_build_tools.sh after deployment.
/firmware/esp32-dualeye/include/generated_voice_menu_catalog.h
/firmware/esp32-dualeye/src/local_voice_responses_generated.cpp
/firmware/esp32-dualeye/lib/es8311/
/firmware/esp32-dualeye/lib/es7210/
/firmware/esp32-dualeye/lib/arduino_network_runtime/
/firmware/esp32-dualeye/lib/.arduino_network_runtime.staging/
/firmware/esp32-dualeye/lib/.waveshare-audio-f16371c/

# Local vendored Nordic/nRF Connect SDK and Zephyr SDK worktrees.
# These are intentionally populated on the Pi by scripts/vendor_nrf_connect_sdk.sh
# or scripts/setup_nrf_connect_sdk_toolchain.sh with VENDOR_NCS_IN_REPO=1.
# Do not push the full third-party SDK payload to this repo.
third_party/ncs/
third_party/zephyr-sdk-*/
!third_party/README.md
!third_party/ncs/README.md

# Test and tooling caches
.tox/
.nox/
.cache/

# OS/editor/temporary noise
.DS_Store
._*
Thumbs.db
Desktop.ini
.idea/
*.swp
*.swo
*.bak
*.orig
*~
