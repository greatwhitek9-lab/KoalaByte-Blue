[Unit]
Description=KoalaByte Blue Pi Hardware Doctor
After=network-online.target bluetooth.service koalabyte-menu.service koalabyte-hdmi.service
Wants=network-online.target bluetooth.service koalabyte-hdmi.service

[Service]
Type=oneshot
WorkingDirectory=/opt/KoalaByte-Blue
Environment=PYTHONPATH=/opt/KoalaByte-Blue/pi-companion:/opt/KoalaByte-Blue
Environment=INSTALL_INNOMAKER_CAN=auto
ExecStart=/opt/KoalaByte-Blue/pi-companion/.venv/bin/python /opt/KoalaByte-Blue/scripts/pi_hardware_doctor.py
RemainAfterExit=yes
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
