[Unit]
Description=KoalaByte Blue Headless Menu and K1-K8 Controller
After=network-online.target bluetooth.service systemd-user-sessions.service
Wants=network-online.target bluetooth.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/KoalaByte-Blue
Environment=PYTHONPATH=/opt/KoalaByte-Blue/pi-companion:/opt/KoalaByte-Blue
Environment=PYTHON_BIN=/opt/KoalaByte-Blue/pi-companion/.venv/bin/python
Environment=PATH=/opt/KoalaByte-Blue/pi-companion/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=KOALABYTE_MENU_SYNC=auto
Environment=KOALABYTE_TTS=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -f /opt/KoalaByte-Blue/scripts/run_headless_menu.py
ExecStart=/opt/KoalaByte-Blue/pi-companion/.venv/bin/python /opt/KoalaByte-Blue/scripts/run_headless_menu.py
Restart=always
RestartSec=3
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
