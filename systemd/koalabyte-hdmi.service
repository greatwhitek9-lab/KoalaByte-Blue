[Unit]
Description=KoalaByte Blue Read-Only HDMI Compositor
After=koalabyte-menu.service systemd-user-sessions.service display-manager.service
Wants=koalabyte-menu.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/KoalaByte-Blue
Environment=PYTHONPATH=/opt/KoalaByte-Blue/pi-companion:/opt/KoalaByte-Blue
Environment=PYTHON_BIN=/opt/KoalaByte-Blue/pi-companion/.venv/bin/python
Environment=PATH=/opt/KoalaByte-Blue/pi-companion/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=KOALABYTE_HDMI=auto
Environment=PYGAME_HIDE_SUPPORT_PROMPT=1
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/test -f /opt/KoalaByte-Blue/scripts/run_hdmi_display.py
ExecStart=/opt/KoalaByte-Blue/pi-companion/.venv/bin/python /opt/KoalaByte-Blue/scripts/run_hdmi_display.py
Restart=always
RestartSec=3
TimeoutStopSec=8
OOMScoreAdjust=200
Nice=5
User=pi
Group=pi

[Install]
WantedBy=multi-user.target
