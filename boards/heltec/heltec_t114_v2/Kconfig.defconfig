if BOARD_HELTEC_T114_V2

config ARM_MPU
	default y

config HW_STACK_PROTECTION
	default y

config GPIO
	default y

# This out-of-tree nRF52840 board must select its native Bluetooth
# controller when an application enables the Bluetooth host. Nordic's
# in-tree nRF52840 boards provide the same default.
config BT_CTLR
	default BT

config USB_DEVICE_REMOTE_WAKEUP
	default n

# NCS v2.9 predates boards/common/usb/Kconfig.cdc_acm_serial.defconfig.
# Applications using the UF2 qualifier select the legacy USB CDC ACM stack in
# their prj.conf.

# Timing in nanoseconds / cycles at 64MHz for led strip
config DELAY_T0H
	default 19

config DELAY_T1H
	default 38

config DELAY_T0L
	default 58

config DELAY_T1L
	default 38

endif # BOARD_HELTEC_T114_V2
