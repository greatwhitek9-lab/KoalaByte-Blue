/* Keep only the ST7789 display bus active for this hardware gate. */

&spi3 {
	status = "disabled";
};

&uart1 {
	status = "disabled";
};

&led_strip {
	status = "disabled";
};

&ieee802154 {
	status = "disabled";
};

&bt_hci_sdc {
	status = "disabled";
};

&bt_hci_controller {
	status = "disabled";
};
